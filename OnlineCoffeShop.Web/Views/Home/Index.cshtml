@model IEnumerable<Product>
@{
    ViewData["Title"] = "Товары";
}

@foreach (var product in Model)
{
    <div>
        <div>@product.Id</div>
        <div>
            <a asp-controller="Product" asp-action="Index" asp-route-id="@product.Id">@product.Name</a>
        </div>
        <div>@product.Price</div>
    </div>
    <br />
}
