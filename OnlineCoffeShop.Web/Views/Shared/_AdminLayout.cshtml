@{
    Layout = "_Layout";
    // теперь подсвечиваем по имени КОНТРОЛЛЕРА, а не action
    var controller = (ViewContext.RouteData.Values["controller"] as string ?? "").ToLower();
    string Active(string c) => controller == c.ToLower() ? "active" : "";
}
<div class="admin shell">
    <aside class="admin-side">
        <h3 class="admin-side-title">Администрирование</h3>
        <nav class="admin-menu">
            <a class="admin-menu-item @Active("Orders")"   asp-area="Admin" asp-controller="Orders"   asp-action="Index">Заказы</a>
            <a class="admin-menu-item @Active("Users")"    asp-area="Admin" asp-controller="Users"    asp-action="Index">Пользователи</a>
            <a class="admin-menu-item @Active("Roles")"    asp-area="Admin" asp-controller="Roles"    asp-action="Index">Роли</a>
            <a class="admin-menu-item @Active("Products")" asp-area="Admin" asp-controller="Products" asp-action="Index">Товары</a>
        </nav>
    </aside>
    <section class="admin-content">
        @RenderBody()
    </section>
</div>

<div id="confirm-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-box">
        <h3 class="modal-title">Подтверждение удаления</h3>
        <p class="modal-text" data-confirm-text></p>
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" data-confirm-cancel>Отмена</button>
            <button type="button" class="btn btn-danger" data-confirm-ok>Удалить</button>
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/admin-confirm.js" asp-append-version="true"></script>
}