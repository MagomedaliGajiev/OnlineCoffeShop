@model ProductCardModel
@inject ICompareRepository Compare
@{
    var p = Model.Product;
    var full = (int)Math.Round(p.AverageRating);
}
<article class="pcard" onclick="location.href='@Url.Action("Details","Product", new { slug = p.Slug })'">
    <div class="media">
        <partial name="_ProductArt" model="p" />
        @if (p.Tag == ProductTag.New) { <span class="tag tag-new corner-tag">NEW</span> }
        @if (p.Tag == ProductTag.Sale && p.OldPrice.HasValue) { <span class="tag tag-sale corner-tag">−@p.DiscountPercent%</span> }
        <form method="post" asp-area="" asp-controller="Fav" asp-action="Toggle" asp-route-returnUrl="@Model.ReturnUrl" onclick="event.stopPropagation();">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@p.Id" />
            <button type="submit" class="heart @(Model.IsFav ? "on" : "")" onclick="event.stopPropagation();">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="@(Model.IsFav ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.8">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                </svg>
            </button>
        </form>
        <form method="post" asp-area="" asp-controller="Compare" asp-action="Toggle" asp-route-returnUrl="@Model.ReturnUrl" onclick="event.stopPropagation();">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@p.Id" />
            <button type="submit" class="compare-btn @(Compare.IsInCompare(p.Id) ? "on" : "")" title="Сравнить" onclick="event.stopPropagation();">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="6" y1="21" x2="6" y2="11" /><line x1="12" y1="21" x2="12" y2="3" /><line x1="18" y1="21" x2="18" y2="14" />
                </svg>
            </button>
        </form>
    </div>
    <div class="body">
        <div class="name">@p.Name</div>
        <div class="meta">@(p.Roast is null ? "" : $"{p.Roast} обжарка · ")@p.Type</div>
        <div class="rating-row">
            <div class="rating-stars">
                @for (var i = 0; i < 5; i++)
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="@(i < full ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.5">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                    </svg>
                }
            </div>
            <span class="rating-score">@p.AverageRating.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)</span>
            <span class="muted">(@p.ReviewCount)</span>
        </div>
        <div class="price-row">
            <div>
                <span class="price">@p.Price.ToString("N0", new System.Globalization.CultureInfo("ru-RU")) ₽</span>
                @if (p.OldPrice.HasValue)
                {
                    <span class="price-old">@p.OldPrice.Value.ToString("N0", new System.Globalization.CultureInfo("ru-RU")) ₽</span>
                }
            </div>
            <form method="post" asp-area="" asp-controller="Cart" asp-action="Add" asp-route-returnUrl="@Model.ReturnUrl" onclick="event.stopPropagation();">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@p.Id" />
                <button type="submit" class="btn btn-primary btn-sm" onclick="event.stopPropagation();">В корзину</button>
            </form>
        </div>
    </div>
</article>