@* @inject SignInManager<IdentityUser> SignInManager *@
@* @inject UserManager<IdentityUser> UserManager *@
@inject ICartService Cart
@inject IFavoritesService Favs
@{
    var cartCount = Cart.CountUnits();
    var favCount = Favs.Count();
    // var isAuth = SignInManager.IsSignedIn(User);
    var route = (ViewContext.RouteData.Values["controller"] as string ?? "home").ToLower();
    var hideChrome = ViewBag.HideChrome as bool? ?? false;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BeanHouse</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        @if (!hideChrome)
        {
            <header class="topbar">
                <div class="shell">
                    <div class="row">
                        <a class="brand" asp-controller="Home" asp-action="Index">
                            <div class="brand-mark">B</div>
                            <span class="brand-name">BeanHouse</span>
                        </a>
                        <nav class="nav">
                            <a class="@(route == "home" ? "active" : "")" asp-controller="Home" asp-action="Index">Каталог</a>
                            <a>О нас</a>
                            <a>Доставка</a>
                            <a>Контакты</a>
                        </nav>
                        <form class="searchbar" method="get" asp-controller="Home" asp-action="Index">
                            <span class="icon">⌕</span>
                            <input name="q" placeholder="Найти кофе, чашку, кофемолку…" />
                        </form>
                        <a class="icon-btn" asp-controller="Home" asp-action="Index" title="Избранное">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="stroke: rgb(205, 156, 46)">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                            </svg>
                            @if (favCount > 0)
                            {
                                <span class="badge">@favCount</span>
                            }
                        </a>
                        @* <a class="icon-btn" asp-controller="@(isAuth ? "Profile" : "Account")" asp-action="@(isAuth ? "Index" : "Login")" title="Профиль"> *@
                        @*     <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="stroke: rgb(205, 156, 46)"> *@
                        @*         <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /> *@
                        @*         <circle cx="12" cy="7" r="4" /> *@
                        @*     </svg> *@
                        @* </a> *@
                        <a class="icon-btn" asp-controller="Cart" asp-action="Index" title="Корзина">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="stroke: rgb(205, 156, 46)">
                                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                                <line x1="3" y1="6" x2="21" y2="6" />
                                <path d="M16 10a4 4 0 0 1-8 0" />
                            </svg>
                            @if (cartCount > 0)
                            {
                                <span class="badge">@cartCount</span>
                            }
                        </a>
                    </div>
                </div>
            </header>
        }

        <main>
            @RenderBody()
        </main>

        @if (!hideChrome)
        {
            <partial name="_Footer" />
        }

        @if (TempData["Toast"] is string toast)
        {
            <div class="toast">@toast</div>
        }
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>