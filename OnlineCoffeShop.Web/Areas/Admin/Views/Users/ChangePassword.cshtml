@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Смена пароля";
    Layout = "_AdminLayout";
}
<h1 class="admin-title">Смена пароля</h1>

<form asp-area="Admin" asp-controller="Users" asp-action="ChangePassword" method="post" class="admin-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="field-error"></div>

    <div class="form-row">
        <label asp-for="NewPassword" class="field-label"></label>
        <input class="field" asp-for="NewPassword" />
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>
    <div class="form-row">
        <label asp-for="ConfirmPassword" class="field-label"></label>
        <input class="field" asp-for="ConfirmPassword" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-cta">Сменить пароль</button>
    <a class="btn btn-ghost" asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@Model.Id">Отмена</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }