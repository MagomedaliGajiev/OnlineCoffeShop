@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Товары";
    Layout = "_AdminLayout";
}
<div class="admin-head" style="display:flex;justify-content:space-between;align-items:center">
    <h1 class="admin-title">Товары</h1>
    <a class="btn btn-cta" asp-area="Admin" asp-controller="Products" asp-action="Create">+ Добавить товар</a>
</div>

<table class="admin-table" style="width:100%;border-collapse:collapse;margin-top:16px">
    <thead>
    <tr>
        <th style="text-align:left">Название</th>
        <th style="text-align:left">Категория</th>
        <th style="text-align:right">Цена</th>
        <th style="text-align:right">Действия</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Name</td>
            <td>@p.Category.DisplayName()</td>
            <td style="text-align:right">@p.Price.ToString("N0") ₽</td>
            <td style="text-align:right">
                <div class="admin-actions">
                    <a class="btn btn-sm btn-ghost" asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
                        Подробно
                    </a>
                    <a class="btn btn-sm btn-ghost" asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        Редактировать
                    </a>
                    <form asp-area="Admin" asp-controller="Products" asp-action="Delete" asp-route-id="@p.Id" method="post"
                          onsubmit="return confirm('Удалить товар «@p.Name»?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            Удалить
                        </button>
                    </form>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>